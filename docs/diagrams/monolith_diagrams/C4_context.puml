@startuml Система управления умным домом - Контекст (C4 Level 1)

!include  ../C4_diagrams/C4_Context.puml

title Контекст системы управления отоплением

Person(admin, "Администратор", "Управляет настройками системы")
Person(user, "Пользователь", "Контролирует температуру через мобильное приложение")

System(smart_home, "Система управления отоплением", "Монолитное приложение для контроля климата в умном доме")

System_Ext(mobile_app, "Мобильное приложение", "iOS/Android клиент для пользователей")
System_Ext(sensors, "Датчики температуры", "IoT устройства, измеряющие температуру")
System_Ext(heating, "Отопительные приборы", "Котлы, конвекторы и другие устройства")

Rel(admin, smart_home, "Настраивает параметры", "HTTPS")
Rel(user, mobile_app, "Управляет температурой", "Push-уведомления")
Rel(mobile_app, smart_home, "Отправляет команды", "REST API")
Rel(smart_home, heating, "Контролирует", "MQTT/WiFi")
Rel(sensors, smart_home, "Отправляет данные", "MQTT")

@enduml